---
import {
  MenuCustomerPreviewDevice,
  MenuEditorPreviewDevice,
} from "@/components/MenuPreviewDevices";
---

<section class="mx-auto my-28 max-w-xl space-y-6 px-6 text-center">
  <div class="space-y-2">
    <h2 class="text-lg font-semibold leading-snug">
      Keep your menu current while you focus on your business.
    </h2>
    <p class="text-[15px] font-medium text-neutral-600">
      Update prices, availability, and categories in seconds. Your customers
      always see the latest version without creating a new menu or replacing
      your QR code.
    </p>
  </div>

  <MenuEditorPreviewDevice client:visible />
</section>

<section class="mx-auto my-28 max-w-xl space-y-6 px-6">
  <div class="text-center">
    <h2 class="text-lg font-semibold leading-snug">
      Give customers one reliable place to find your menu.
    </h2>
    <p class="text-[15px] font-medium text-neutral-600">
      Whether they scan your QR code or tap your link, they'll always see what's
      available, what it costs, and how to order.
    </p>
  </div>

  <MenuCustomerPreviewDevice client:visible />
</section>
