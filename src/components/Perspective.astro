---
import owner512Avif from "@/assets/owner-512.avif";
import owner768Avif from "@/assets/owner-768.avif";
import owner1024Avif from "@/assets/owner-1024.avif";
import owner512Webp from "@/assets/owner-512.webp";
import owner768Webp from "@/assets/owner-768.webp";
import owner1024Webp from "@/assets/owner-1024.webp";
import { CTA_COPY } from "@/constants";

const perspectivePoints = [
  "Show customers your food, prices, and today's specials before they order or stop by. One simple menu gives them a clear place to see what's available.",
  "No website. No ecommerce setup. No delivery app. Just your menu online.",
];
---

<section class="mt-28 mb-14 space-y-6 px-6 max-w-3xl mx-auto">
  <article
    class="p-2 grid grid-cols-1 sm:grid-cols-2 gap-2 rounded-xl ring-1 ring-neutral-300"
  >
    <div
      class="aspect-16/10 overflow-hidden rounded-lg bg-neutral-100 sm:aspect-auto sm:h-full"
    >
      <picture class="block h-full">
        <source
          type="image/avif"
          srcset={`${owner512Avif.src} 512w, ${owner768Avif.src} 768w, ${owner1024Avif.src} 1024w`}
          sizes="(max-width: 639px) calc(100vw - 4rem), (max-width: 768px) calc(50vw - 2rem), 304px"
        />
        <source
          type="image/webp"
          srcset={`${owner512Webp.src} 512w, ${owner768Webp.src} 768w, ${owner1024Webp.src} 1024w`}
          sizes="(max-width: 639px) calc(100vw - 4rem), (max-width: 768px) calc(50vw - 2rem), 304px"
        />
        <img
          src={owner768Webp.src}
          width={owner768Webp.width}
          height={owner768Webp.height}
          alt="Bakery owner helping a customer at a market stall"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-[center_20%] sm:object-center"
        />
      </picture>
    </div>
    <div class="flex flex-col space-y-6 p-4">
      <p class="font-semibold text-lg">
        Show today's menu before customers ask.
      </p>
      {
        perspectivePoints.map((point) => (
          <p class="text-neutral-700 font-[550] text-[15px]">{point}</p>
        ))
      }
      <a
        href="https://app.menunook.com"
        class="inline-flex h-10 w-full mt-auto items-center justify-center gap-2 whitespace-nowrap rounded-full bg-primary px-4 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90 focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] outline-none duration-300 disabled:pointer-events-none disabled:opacity-50 hover:shadow-[0_6px_20px_rgba(0,0,0,0.12)]"
      >
        {CTA_COPY}
      </a>
    </div>
  </article>
</section>
