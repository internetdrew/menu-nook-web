---
import { Check } from "lucide-react";

const featurePoints = [
  "Show your full menu",
  "Update items anytime",
  "Share one link or QR code",
];
---

<section class="mx-auto my-28 max-w-md space-y-6 px-6">
  <div class="text-center space-y-2">
    <h2 class="text-lg font-semibold leading-snug text-pretty">
      Your menu, online.
    </h2>
    <p class="text-[15px] font-medium text-neutral-600">
      A clear, up-to-date menu for customers to see.
    </p>
  </div>

  <div
    class="mx-auto max-w-md space-y-5 rounded-lg border border-neutral-200 bg-white p-4 shadow-[0_10px_30px_rgba(0,0,0,0.08),0_1px_2px_rgba(0,0,0,0.06)]"
  >
    <div class="space-y-1">
      <p class="flex items-baseline gap-2">
        <span class="text-4xl font-bold tracking-tight">$10</span>
        <span class="text-sm font-medium text-neutral-600"
          >one-time payment</span
        >
      </p>
      <p class="text-sm font-medium text-neutral-600">No subscription.</p>
    </div>

    <ul class="space-y-2.5 text-neutral-700">
      {
        featurePoints.map((point) => (
          <li class="flex items-start gap-2 text-sm leading-snug">
            <Check className="mt-0.5 size-3.5 shrink-0 text-pink-600" />
            {point}
          </li>
        ))
      }
    </ul>

    <a
      href="https://app.menunook.com"
      class="inline-flex h-10 w-full items-center justify-center gap-2 whitespace-nowrap rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-all duration-300 outline-none hover:bg-primary/90 hover:shadow-[0_6px_20px_rgba(0,0,0,0.12)] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50"
    >
      Create your menu
    </a>
  </div>
</section>
