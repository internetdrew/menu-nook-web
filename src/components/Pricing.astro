---
import { CTA_COPY } from "../constants";
const featurePoints = [
  "Show your full menu",
  "Update items anytime",
  "Share one link or QR code",
];
---

<section class="mx-auto mt-28 mb-14 max-w-md space-y-6 px-6 text-center">
  <div class="mx-auto space-y-2">
    <h2 class="text-lg font-semibold leading-tight text-pretty">
      Get your menu online.
    </h2>
    <p class="text-[15px] font-medium text-neutral-600">
      Free. No credit card required.
    </p>
  </div>

  <a
    href="https://app.menunook.com"
    class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-all duration-300 outline-none hover:bg-primary/90 hover:shadow-[0_6px_20px_rgba(0,0,0,0.12)] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 sm:w-auto"
  >
    {CTA_COPY}
  </a>
</section>
